# ======================
# TokenEye Configuration
# ======================
# Copy this file to .env and fill in your values

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALERT_CHANNEL=-100xxxxxxxxxx
TELEGRAM_PRO_ALERT_CHANNEL=-100xxxxxxxxxx

# --- Helius RPC API Keys ---
HELIUS_API_KEY_1=your_helius_key_1
HELIUS_API_KEY_2=your_helius_key_2
HELIUS_API_KEY_3=your_helius_key_3
HELIUS_API_KEY_4=your_helius_key_4

# --- Database ---
# For local development:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/tokenscout
# For local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/tokenscout
# For AWS RDS:
# DATABASE_URL=postgresql+psycopg2://postgres:password@your-rds-endpoint.rds.amazonaws.com:5432/tokenscout

# --- AWS (for backups) ---
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=tokeneye-backups
